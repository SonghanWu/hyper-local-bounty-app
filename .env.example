# ═══════════════════════════════════════════════════════════════
# PinGig Backend — Environment Variables Template
#
# Usage:
#   cp .env.example .env
#   Fill in the real values. The .env file is git-ignored and
#   must never be committed to the repository.
# ═══════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (PostgreSQL) ───────────────────────────────────
# Within the Docker network, DB_HOST must match the service name "postgres"
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=bounty_user
DB_PASSWORD=your_strong_password_here
DB_DATABASE=bounty_db

# ─── Cache (Redis) ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT Authentication ──────────────────────────────────────
# Generate a secret with: openssl rand -base64 64
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRATION=7d
