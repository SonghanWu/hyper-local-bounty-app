# ═══════════════════════════════════════════════════════════════
# PinGig 后端 — 环境变量模板
#
# 使用方法：
#   cp .env.example .env
#   然后填入真实值，.env 文件不进 Git（已在 .gitignore 中）
# ═══════════════════════════════════════════════════════════════

# ─── 应用 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── 数据库（PostgreSQL）────────────────────────────────────
# docker-compose 内部网络中，HOST 填 Docker 服务名 "postgres"
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=bounty_user
DB_PASSWORD=your_strong_password_here
DB_DATABASE=bounty_db

# ─── 缓存（Redis）────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT 认证 ────────────────────────────────────────────────
# 生成方法：openssl rand -base64 64
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRATION=7d
