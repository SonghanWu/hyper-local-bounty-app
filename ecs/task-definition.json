{
  "family": "pingig-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],

  "cpu": "512",
  "memory": "1024",

  "executionRoleArn": "arn:aws:iam::105100038977:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::105100038977:role/ecsTaskRole",

  "containerDefinitions": [
    {
      "name": "pingig-app",
      "image": "105100038977.dkr.ecr.us-east-1.amazonaws.com/pingig-app:latest",
      "essential": true,

      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],

      "environment": [
        { "name": "NODE_ENV",        "value": "production" },
        { "name": "PORT",            "value": "3000" },
        { "name": "DB_PORT",         "value": "5432" },
        { "name": "REDIS_PORT",      "value": "6379" },
        { "name": "JWT_EXPIRATION",  "value": "7d" }
      ],

      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:105100038977:parameter/pingig/DB_HOST"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:ssm:us-east-1:105100038977:parameter/pingig/DB_USERNAME"
        },
        {
          "name": "DB_DATABASE",
          "valueFrom": "arn:aws:ssm:us-east-1:105100038977:parameter/pingig/DB_DATABASE"
        },
        {
          "name": "REDIS_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:105100038977:parameter/pingig/REDIS_HOST"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:105100038977:secret:pingig/DB_PASSWORD"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:105100038977:secret:pingig/JWT_SECRET"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/pingig-app",
          "awslogs-region":        "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group":  "true"
        }
      },

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1))\""
        ],
        "interval":    30,
        "timeout":     5,
        "retries":     3,
        "startPeriod": 60
      }
    }
  ]
}
